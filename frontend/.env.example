# Local development (cookie sessions on *.localhost):
# Leave empty — Next.js rewrites /api → backend so cookies stay same-origin.
NEXT_PUBLIC_API_URL=

# Staging/production Netlify → Render (absolute API + SameSite=None Secure cookies):
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com

NEXT_PUBLIC_DEMO_PRACTICE_URL=http://eastern-cape.localhost:3000

# Staging connectivity: exact platform frontend host(s) — never inferred as Practice tenants.
# NEXT_PUBLIC_PLATFORM_HOSTNAME=MediNathi-staging.netlify.app
# Practice tenants only under this base: practice-a.<base>
# NEXT_PUBLIC_APP_BASE_DOMAIN=MediNathi-staging.netlify.app

# Optional local rewrite target for next.config.js (default http://127.0.0.1:3001)
# API_REWRITE_TARGET=http://127.0.0.1:3001
