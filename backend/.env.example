DATABASE_URL="postgresql://user:password@localhost:5432/MediNathi_db"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
PORT=3001
NODE_ENV=development
# Deployment tier for fail-closed checks (development | staging | production | test)
# APP_ENV is authoritative for UAT invitation/activation links (staging may enable; production never).
# APP_ENV=development
FRONTEND_URL="http://localhost:3000"
# Optional dedicated Super Admin / platform frontend origin (defaults to FRONTEND_URL).
# PLATFORM_FRONTEND_URL="http://localhost:3000"
# Invitation / activation / password-reset emails.
# canonical = platform origin (operational fallback; ?tenant= UX).
# subdomain = https://{practice}.{APP_BASE_DOMAIN}/invite?token=...
# TENANT_ROUTING_MODE=canonical
# Production wildcard practices:
# TENANT_ROUTING_MODE=subdomain
# FRONTEND_URL=https://medinathi.co.za
# PLATFORM_FRONTEND_URL=https://medinathi.co.za
# APP_BASE_DOMAIN=medinathi.co.za
# PLATFORM_HOSTNAME=api.medinathi.co.za
# Do not list every practice in CORS_ALLOWED_ORIGINS — valid one-label https origins
# under APP_BASE_DOMAIN are allowed dynamically (no CORS *).

# Staging connectivity: exact platform/API hosts (comma-separated) — never inferred as Practice tenants.
# PLATFORM_HOSTNAME=MediNathi-api.onrender.com
# Practice tenants only under this base: practice-a.<APP_BASE_DOMAIN>
# APP_BASE_DOMAIN=MediNathi-staging.netlify.app

GROQ_API_KEY=""
# GROQ_TIMEOUT_MS=90000
# Chat model for SOAP extraction, clinical letters, and referral drafts (Whisper ASR unchanged).
# GROQ_SCRIBE_MODEL=openai/gpt-oss-120b
RESEND_API_KEY=""
INQUIRY_NOTIFICATION_EMAIL="owner@MediNathi.co.za"
RESEND_FROM_EMAIL="MediNathi <notifications@MediNathi.co.za>"
# Development/test skip Resend by default (unverified medispace.co.za → 403). Staging/production still send.
# RESEND_ENABLE_IN_DEV=true
# Comma-separated extra browser origins for CORS + CSRF (staging hosts).
CORS_ALLOWED_ORIGINS=""
# Cross-site Netlify → Render cookies: COOKIE_SECURE=true COOKIE_SAMESITE=None
# COOKIE_SECURE=
# COOKIE_SAMESITE=
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Private clinical media (consultation recordings). Never expose via express.static.
# Dev/test: CLINICAL_STORAGE_DRIVER=local (default root: uploads/clinical)
# Staging/production on Render: CLINICAL_STORAGE_DRIVER=render-disk
# CLINICAL_STORAGE_ROOT=/var/data/clinical
CLINICAL_STORAGE_DRIVER=local
# CLINICAL_STORAGE_ROOT=

# Public practice logos. Render local disk (cwd/uploads/logos) is ephemeral — do not use in staging/production.
# Dev/test: PRACTICE_LOGO_STORAGE_DRIVER=local
# Staging/production on Render: PRACTICE_LOGO_STORAGE_DRIVER=render-disk
# PRACTICE_LOGO_STORAGE_ROOT=/var/data/logos
PRACTICE_LOGO_STORAGE_DRIVER=local
# PRACTICE_LOGO_STORAGE_ROOT=
# Canonical API origin so public practice-info returns absolute logo URLs
# (never relative to pilot.medinathi.co.za).
# PUBLIC_API_URL=https://api.medinathi.co.za

# Optional EFT instructions for Owner billing (omit to show "not configured")
# EFT_ACCOUNT_HOLDER=
# EFT_BANK=
# EFT_ACCOUNT_NUMBER=
# EFT_BRANCH_CODE=
# EFT_REFERENCE_GUIDANCE=

# Subscription invoice payment terms (days from paid-period start). Default 14.
# SUBSCRIPTION_INVOICE_DUE_DAYS=14

# LOCAL/STAGING ONLY — never when APP_ENV=production.
# When true and APP_ENV is staging|development|test, Super Admin create/resend
# and Reception patient create/resend may return a one-time UAT invitation/activation URL.
# Render staging typically: NODE_ENV=production APP_ENV=staging ENABLE_UAT_INVITATION_LINKS=true
# ENABLE_UAT_INVITATION_LINKS=true

# Staging/production DB migrations: npm run db:migrate:deploy  (prisma migrate deploy)
# NEVER run prisma migrate reset or development seed against staging/production.
